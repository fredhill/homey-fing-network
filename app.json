{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.fredhill.fing",
  "version": "1.0.0",
  "compatibility": ">=13.0.0",
  "sdk": 3,
  "runtime": "python",
  "pythonVersion": "3.13",
  "name": {
    "en": "Fing Network Monitor"
  },
  "description": {
    "en": "Track network device presence and detect unknown devices using your Fingbox."
  },
  "tags": {
    "en": [
      "fing",
      "fingbox",
      "network",
      "presence",
      "wifi",
      "lan",
      "security"
    ]
  },
  "category": [
    "security"
  ],
  "brandColor": "#00b0b0",
  "pythonPackages": [
    "fing-agent-api>=1.0.3"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Fred Hill",
    "email": "fredhill@mac.com"
  },
  "homepage": "https://github.com/fredhill/homey-fing-network",
  "support": "https://github.com/fredhill/homey-fing-network/issues",
  "source": "https://github.com/fredhill/homey-fing-network",
  "flow": {
    "triggers": [
      {
        "id": "new_unknown_device",
        "title": {
          "en": "An unknown device appeared on the network"
        },
        "titleFormatted": {
          "en": "An unknown device appeared on [[device]]'s network"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=fingbox"
          },
          {
            "name": "device",
            "type": "device",
            "placeholder": {
              "en": "Which Fingbox?"
            },
            "filter": "driver_id=fingbox"
          }
        ],
        "tokens": [
          {
            "name": "device_name",
            "type": "string",
            "title": {
              "en": "Device Name"
            },
            "example": {
              "en": "iPhone"
            }
          },
          {
            "name": "mac_address",
            "type": "string",
            "title": {
              "en": "MAC Address"
            },
            "example": {
              "en": "AA:BB:CC:DD:EE:FF"
            }
          },
          {
            "name": "ip_address",
            "type": "string",
            "title": {
              "en": "IP Address"
            },
            "example": {
              "en": "10.0.0.100"
            }
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Fingbox"
      },
      "class": "other",
      "capabilities": [
        "alarm_connectivity",
        "online_count"
      ],
      "capabilitiesOptions": {
        "alarm_connectivity": {
          "title": {
            "en": "Connection Lost"
          }
        },
        "online_count": {
          "title": {
            "en": "Online Devices"
          },
          "decimals": 0
        }
      },
      "images": {
        "small": "/drivers/fingbox/assets/images/small.png",
        "large": "/drivers/fingbox/assets/images/large.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Connection"
          },
          "children": [
            {
              "id": "ip",
              "type": "text",
              "label": {
                "en": "IP Address"
              },
              "value": "",
              "hint": {
                "en": "Local IP address of your Fingbox (e.g. 10.0.0.75)"
              }
            },
            {
              "id": "port",
              "type": "number",
              "label": {
                "en": "Port"
              },
              "value": 49090,
              "min": 1,
              "max": 65535,
              "hint": {
                "en": "Fing Local API port (default: 49090)"
              }
            }
          ]
        }
      ],
      "id": "fingbox"
    },
    {
      "name": {
        "en": "Network Device"
      },
      "class": "sensor",
      "capabilities": [
        "presence_status",
        "alarm_presence",
        "ip_address",
        "last_seen"
      ],
      "capabilitiesOptions": {
        "presence_status": {
          "title": {
            "en": "Status"
          }
        },
        "alarm_presence": {
          "title": {
            "en": "Away"
          }
        },
        "ip_address": {
          "title": {
            "en": "IP Address"
          }
        },
        "last_seen": {
          "title": {
            "en": "Last Seen"
          }
        }
      },
      "images": {
        "small": "/drivers/network_device/assets/images/small.png",
        "large": "/drivers/network_device/assets/images/large.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "network_device"
    }
  ],
  "capabilities": {
    "alarm_connectivity": {
      "type": "boolean",
      "title": {
        "en": "Connection Lost"
      },
      "desc": {
        "en": "True when the Fingbox is unreachable on the local network."
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "ip_address": {
      "type": "string",
      "title": {
        "en": "IP Address"
      },
      "desc": {
        "en": "Current IP address of the network device."
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "last_seen": {
      "type": "string",
      "title": {
        "en": "Last Seen"
      },
      "desc": {
        "en": "Timestamp of the last time Fing detected a state change for this device."
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "online_count": {
      "type": "number",
      "title": {
        "en": "Online Devices"
      },
      "desc": {
        "en": "Number of devices currently online on the network."
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "decimals": 0
    },
    "presence_status": {
      "type": "enum",
      "title": {
        "en": "Status"
      },
      "desc": {
        "en": "Whether the device is currently present on the network."
      },
      "values": [
        {
          "id": "present",
          "title": {
            "en": "Present"
          }
        },
        {
          "id": "away",
          "title": {
            "en": "Away"
          }
        }
      ],
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    }
  }
}