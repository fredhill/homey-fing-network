{
  "name": { "en": "Fingbox" },
  "class": "other",
  "capabilities": [
    "alarm_connectivity",
    "online_count"
  ],
  "capabilitiesOptions": {
    "alarm_connectivity": {
      "title": { "en": "Connection Lost" }
    },
    "online_count": {
      "title": { "en": "Online Devices" },
      "decimals": 0
    }
  },
  "images": {
    "small": "/drivers/fingbox/assets/images/small.png",
    "large": "/drivers/fingbox/assets/images/large.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": { "next": "add_devices" }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": { "en": "Connection" },
      "children": [
        {
          "id": "ip",
          "type": "text",
          "label": { "en": "IP Address" },
          "value": "",
          "hint": { "en": "Local IP address of your Fingbox (e.g. 10.0.0.75)" }
        },
        {
          "id": "port",
          "type": "number",
          "label": { "en": "Port" },
          "value": 49090,
          "min": 1,
          "max": 65535,
          "hint": { "en": "Fing Local API port (default: 49090)" }
        }
      ]
    }
  ]
}
